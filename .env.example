# Optional overrides only; normal setup reads the Projects .env directly.
# Never commit tokens, .env, .env.deploy, or .projects/.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_DATABASE_NAME=hello-projects
WORKER_NAME=
# Use a common token OR the two service-specific tokens below.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKERS_API_TOKEN=
CLOUDFLARE_D1_API_TOKEN=
# Optional before first deployment. After deployment, set its printed HTTPS origin.
PUBLIC_SITE_URL=
